{
  "title": "Kimi and Claude E2E smoke",
  "driver": "kimi-cli",
  "max_idle": 1,
  "max_retry_wait": 0,
  "inject_git_rules": true,
  "tag": "kimi-e2e-smoke",
  "pricing": {
    "kimi-code/kimi-for-coding": {
      "input": 1,
      "output": 1,
      "cached": 1
    }
  },
  "agents": [
    {
      "name": "kimi-oauth-low",
      "count": 1,
      "model": "kimi-code/kimi-for-coding",
      "auth": "oauth",
      "effort": "low",
      "context": "none",
      "prompt": "smoke/kimi-e2e/prompts/kimi-oauth-low.md",
      "tag": "kimi-oauth-low"
    },
    {
      "name": "kimi-auto-max",
      "count": 1,
      "model": "kimi-code/kimi-for-coding",
      "effort": "max",
      "context": "full",
      "prompt": "smoke/kimi-e2e/prompts/kimi-auto-max.md",
      "tag": "kimi-auto-max"
    },
    {
      "name": "claude-oauth-low",
      "count": 1,
      "driver": "claude-code",
      "model": "claude-sonnet-4-6",
      "auth": "oauth",
      "effort": "low",
      "context": "slim",
      "prompt": "smoke/kimi-e2e/prompts/claude-oauth-low.md",
      "tag": "claude-oauth-low"
    }
  ]
}
